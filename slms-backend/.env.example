PORT=3000

# Origin allowed to make cross-origin requests (the frontend's dev server).
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SLMS
DB_USER=slms_application_user
DB_PASSWORD=replace-me

# Signing key for auth tokens. Anyone holding this can mint a valid token for
# any user, so treat it like a password: generate per environment, never commit.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me
JWT_EXPIRES_IN=8h
